{
  "name": "aprisrc-kit",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/pwa"
  ],
  "scripts": {
    "cert:generate": "node scripts/generate-dev-cert.mjs",
    "dev": "concurrently -n server,pwa -c blue,green \"npm run dev:server\" \"npm run dev:pwa\"",
    "dev:pwa": "npm --workspace @apris/pwa run dev",
    "dev:server": "uv run --directory apps/server --no-dev uvicorn apris_server.app:app --reload --host 0.0.0.0 --port 8000",
    "build": "npm --workspace @apris/pwa run build",
    "test": "npm --workspace @apris/pwa run test",
    "test:starter": "npm --workspace @apris/pwa run test:starter",
    "typecheck": "npm --workspace @apris/pwa run typecheck"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
