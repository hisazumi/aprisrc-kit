# Copy this template to .env in this directory; never commit real API keys.
# .env is ignored by Git. This example contains no credentials.
# From apps/server, explicitly load it when starting the server:
# uv run --env-file .env --no-dev uvicorn apris_server.app:app --reload --host 127.0.0.1 --port 8000
# npm run dev does not automatically load this file.
# Start the frontend separately from the repository root: npm run dev:pwa
# Existing shell environment variables take precedence over this file.

# Keep LLM trials in the simulator, not on a physical rover.
APRIS_ADAPTER=simulator

# iron-X only; opt-in supervised operation requires the same profile on the
# PC server, robot gateway AND command bridge. See docs/hardware/ironx-supervised.md.
# APRIS_IRONX_PROFILE=supervised_low_speed

# Start without a cloud API. Change rules to gemini to try Gemini.
APRIS_ASSISTANT_PROVIDER=rules

# Gemini: set provider=gemini and fill in the key.
# The model below is the default for Gemini trials; verify access with your account.
# Do not include the models/ prefix. Empty keys cannot enable Gemini.
GEMINI_API_KEY=
APRIS_ASSISTANT_MODEL=gemini-3.8-flash

# OpenAI alternative: set provider=openai, provide its key, and replace the model above.
# OPENAI_API_KEY=
# APRIS_ASSISTANT_MODEL=YOUR_OPENAI_MODEL_ID
