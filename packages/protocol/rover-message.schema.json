{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apris.example/schema/rover-message-v1.json",
  "title": "APRIS client-to-server WebSocket messages",
  "oneOf": [
    { "$ref": "#/$defs/clientHello" },
    { "$ref": "#/$defs/acquireControl" },
    { "$ref": "#/$defs/releaseControl" },
    { "$ref": "#/$defs/drive" },
    { "$ref": "#/$defs/stop" },
    { "$ref": "#/$defs/move" },
    { "$ref": "#/$defs/turn" },
    { "$ref": "#/$defs/cancelMotion" },
    { "$ref": "#/$defs/estop" },
    { "$ref": "#/$defs/clearEstop" },
    { "$ref": "#/$defs/resetPose" },
    { "$ref": "#/$defs/readFrontObstacle" },
    { "$ref": "#/$defs/perceptionObservation" }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "properties": { "v": { "const": 1 } },
      "required": ["v"]
    },
    "clientHello": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "client_hello" },
            "client_kind": {
              "enum": [
                "service_app",
                "operator_console",
                "development_lab",
                "vehicle_perception",
                "physicode_bridge"
              ]
            },
            "device_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "app_version": { "type": "string", "minLength": 1, "maxLength": 64 },
            "build_id": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "required": [
            "type",
            "client_kind",
            "device_id",
            "session_id",
            "app_version",
            "build_id"
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "acquireControl": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "acquire_control" } }, "required": ["type"] }
      ],
      "unevaluatedProperties": false
    },
    "releaseControl": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "release_control" } }, "required": ["type"] }
      ],
      "unevaluatedProperties": false
    },
    "drive": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "drive" },
            "vx": { "type": "number" },
            "vy": { "type": "number" },
            "wz": { "type": "number" },
            "ttl_ms": { "type": "integer", "minimum": 100, "maximum": 2000 },
            "seq": { "type": "integer", "minimum": 0 }
          },
          "required": ["type", "vx", "vy", "wz", "ttl_ms", "seq"]
        }
      ],
      "unevaluatedProperties": false
    },
    "stop": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "stop" }, "reason": { "type": "string", "maxLength": 120 } }, "required": ["type"] }
      ],
      "unevaluatedProperties": false
    },
    "move": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "move" },
            "request_id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "run_id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "effect_id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "distance_m": { "type": "number", "minimum": -5, "maximum": 5, "not": { "const": 0 } },
            "speed_mps": { "type": "number", "minimum": 0.05, "maximum": 0.3 }
          },
          "required": ["type", "request_id", "distance_m", "speed_mps"]
        }
      ],
      "unevaluatedProperties": false
    },
    "turn": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "properties": {
            "type": { "const": "turn" },
            "request_id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "run_id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "effect_id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "angle_deg": { "type": "number", "minimum": -720, "maximum": 720, "not": { "const": 0 } },
            "speed_rad_s": { "type": "number", "minimum": 0.1, "maximum": 1.2 }
          },
          "required": ["type", "request_id", "angle_deg", "speed_rad_s"]
        }
      ],
      "unevaluatedProperties": false
    },
    "cancelMotion": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "cancel_motion" } }, "required": ["type"] }
      ],
      "unevaluatedProperties": false
    },
    "estop": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "estop" }, "reason": { "type": "string", "maxLength": 120 } }, "required": ["type"] }
      ],
      "unevaluatedProperties": false
    },
    "clearEstop": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "clear_estop" } }, "required": ["type"] }
      ],
      "unevaluatedProperties": false
    },
    "resetPose": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "type": { "const": "reset_pose" } }, "required": ["type"] }
      ],
      "unevaluatedProperties": false
    },
    "readFrontObstacle": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "read_front_obstacle" },
            "request_id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "run_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 },
            "effect_id": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 }
          },
          "required": ["type", "request_id"]
        }
      ],
      "unevaluatedProperties": false
    },
    "perceptionObservation": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "perception_observation" },
            "observation_id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "kind": { "enum": ["person", "marker"] },
            "status": { "enum": ["detected", "lost"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "captured_at": { "type": "number", "exclusiveMinimum": 0 },
            "source": { "enum": ["camera", "recorded"] },
            "payload": { "type": "object" }
          },
          "required": [
            "type",
            "observation_id",
            "kind",
            "status",
            "confidence",
            "captured_at",
            "source",
            "payload"
          ]
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
